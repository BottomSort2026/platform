# Copy to .env next to compose.yaml. Nothing here is secret.

# OpenAI-compatible chat completions endpoint the MCP service uses for routing and answers.
# Default in compose.yaml assumes Ollama on the Docker host (http://host.docker.internal:11434/...).
# LLM_URL=http://host.docker.internal:11434/v1/chat/completions
# LLM_MODEL=llama3.1
# LLM_API_KEY=
